{
  "name": "pi-keep-going",
  "version": "0.0.0",
  "description": "Pi extension: one-shot /kg scheduling and usage-limit auto-resume for Anthropic, Codex, and Gemini.",
  "type": "module",
  "license": "MIT",
  "author": "ohlulu",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "scheduler",
    "usage-limit",
    "auto-resume"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
